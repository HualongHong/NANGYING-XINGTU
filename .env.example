# ============================================================================
# 囊萤星图 · LLM 密钥模板（本文件是模板，可入库）
#
# 安全约定：
#   - 真实 key 填在仓库根的 .env（已 gitignore，权限 600），永不提交 git；
#   - 本模板只含空占位与说明，可安全提交；
#   - 密钥只被运行时脚本读取（如 scripts/eval-llm-filter.mjs），
#     任何代码/日志/测试都不得包含真实形态的 key。
# 用法：复制本文件为 .env，填入真实 key，chmod 600 .env。
# ============================================================================

# MiniMax M3（OpenAI 兼容端点 https://api.minimaxi.com/v1，model MiniMax-M3）
MINIMAX_API_KEY=

# DeepSeek V4 Flash（OpenAI 兼容端点 https://api.deepseek.com，model DeepSeek-v4-flash）
DEEPSEEK_API_KEY=

# MinerU 精准档 Token（https://mineru.net/apiManage/token；不填则文档解析走免费档/本地 OCR）
MINERU_API_TOKEN=

# SciVerse 学术证据 Token（https://sciverse.space Console > Tokens；enrich_knowledge_evidence 技能用）
SCIVERSE_API_TOKEN=

# OpenDataLab / OpenXLab AK/SK（https://opendatalab.com 个人中心-密钥管理；成对使用。
# 公共数据集仓库匿名可探查，仅受限仓库需要；inspect_teaching_dataset 技能用）
OPENXLAB_AK=
OPENXLAB_SK=
