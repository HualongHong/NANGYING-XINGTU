# ============================================================
# 共享边界：只有插件共享执行相关的文档随仓库分发
# （源码/契约/用户文档/脚本/测试 = 共享；开发过程文档 = 不共享）
# ============================================================

# ---------- 构建与依赖产物 ----------
node_modules/
dist/
build/
coverage/
.venv/
__pycache__/

# ---------- 密钥与本地配置（绝不入库） ----------
.env
.env.*
!.env.example

# ---------- 开发过程文档（不共享，本地保留；真实说明书 = 根目录 README + docs/ 上层文档） ----------
docs/dev/

# ---------- 本地评估资产（教材扫描件/OCR 产物，不入库） ----------
testfiles/
*.traineddata
tessdata/
.nangying-starmap/

# ---------- 系统与日志杂物 ----------
*.log
.DS_Store

# ---------- 反馈闭环数据（gitignored；含可选敏感调试信息，绝不入库） ----------
.nangying-feedback/
