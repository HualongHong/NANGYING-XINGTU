# ============================================================================
# 囊萤星图 · LLM 密钥模板（本文件是模板，可入库）
#
# 安全约定：
#   - 真实 key 填在仓库根的 .env（已 gitignore，权限 600），永不提交 git；
#   - 本模板只含空占位与说明，可安全提交；
#   - 密钥只被运行时脚本读取（如 scripts/eval-llm-filter.mjs），
#     任何代码/日志/测试都不得包含真实形态的 key。
# 用法：复制本文件为 .env，填入真实 key，chmod 600 .env。
# ============================================================================

# MiniMax M3（OpenAI 兼容端点 https://api.minimaxi.com/v1，model MiniMax-M3）
MINIMAX_API_KEY=

# DeepSeek V4 Flash（OpenAI 兼容端点 https://api.deepseek.com，model DeepSeek-v4-flash）
DEEPSEEK_API_KEY=

# Moonshot/Kimi（OpenAI 兼容端点 https://api.moonshot.cn/v1，model moonshot-v1-8k）
MOONSHOT_API_KEY=

# LLM 调试覆盖（可选：固定提供商/模型/端点，优先级高于配置文件与密钥反推）
# NANGYING_LLM_PROVIDER=deepseek
# NANGYING_LLM_MODEL=deepseek-flash
# NANGYING_LLM_ENDPOINT=https://api.deepseek.com

# MinerU 精准档 Token（https://mineru.net/apiManage/token；不填则文档解析走免费档/本地 OCR）
MINERU_API_TOKEN=

# SciVerse 学术证据 Token（https://sciverse.space Console > Tokens；enrich_knowledge_evidence 技能用）
SCIVERSE_API_TOKEN=

# OpenDataLab / OpenXLab AK/SK（https://opendatalab.com 个人中心-密钥管理；成对使用。
# 公共数据集仓库匿名可探查，仅受限仓库需要；inspect_teaching_dataset 技能用）
OPENXLAB_AK=
OPENXLAB_SK=

# ---------- 向量嵌入（KAG-1 R24，可选：KB 语义召回增强，缺席纯倒排降级） ----------
# OpenAI 兼容 /embeddings 端点；本地端点（如 ollama）API_KEY 可留空
# NANGYING_EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# NANGYING_EMBEDDINGS_MODEL=text-embedding-3-small
# NANGYING_EMBEDDINGS_API_KEY=
# MCP/HTTP server 通道自动加载开关（默认关闭，与 NANGYING_MCP_LLM 同纪律）
# NANGYING_MCP_EMBEDDINGS=1
